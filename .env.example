# Copy to .env and fill in. Never commit .env.

# Laya model
BOT_LAYA_MODEL=english            # english | multilingual | typed-decisions | local checkpoint path
BOT_DEVICE=                       # empty = auto (cuda, mps, xpu, cpu); or cpu / cuda
BOT_HEAD_MAX_LEN=                 # empty = checkpoint default
BOT_MAX_LEN=                      # empty = checkpoint default
BOT_QUESTION_DESIGN=facts_v1      # question design id, see src/laya_agent/decision/questions.py

# Hosted game API (UNRESOLVED until hackathon day)
BOT_GAME_BASE_URL=                # e.g. https://<revealed-on-hackathon-day>
BOT_GAME_TOKEN=                   # auth token, if the API uses one
BOT_GAME_AUTH_HEADER=Authorization
BOT_GAME_AUTH_SCHEME=Bearer       # empty to send the raw token
BOT_HTTP_TIMEOUT_S=10
BOT_HTTP_GET_RETRIES=3

# Loop
BOT_MAX_STEPS=1000
BOT_MAX_STATE_REFETCH=3
BOT_MAX_DECISION_RETRIES=1

# Logging and viewer
BOT_LOG_DIR=logs
BOT_LOG_MAX_FIELD_CHARS=4000
BOT_VIEWER_PORT=8765
